<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ===== PAYMENT FORM (hidden after success) ===== -->
        <LinearLayout
            android:id="@+id/layoutPaymentForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp" android:background="#3A7BD5">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/payment_secure_label"
                        android:textColor="#B3D4FF" android:textSize="13sp"
                        android:textAlignment="viewStart" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/payment_ssl_note"
                        android:textColor="#FFFFFF" android:textSize="15sp"
                        android:layout_marginTop="4dp" android:textAlignment="viewStart" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Amount card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:padding="18dp" android:background="#FFFFFF">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/payment_amount_label"
                            android:textColor="#AAAAAA" android:textSize="11sp"
                            android:letterSpacing="0.1" android:textAlignment="viewStart" />
                        <TextView android:id="@+id/tvPaymentAmount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#1A1A1A" android:textSize="28sp" android:textStyle="bold"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💳" android:textSize="36sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card form -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/payment_card_info_label"
                        android:textColor="#AAAAAA" android:textSize="11sp"
                        android:letterSpacing="0.1" android:layout_marginBottom="12dp"
                        android:textAlignment="viewStart" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/payment_card_number"
                        android:textColor="#888888" android:textSize="12sp"
                        android:textAlignment="viewStart" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:layout_marginBottom="12dp"
                        app:boxStrokeColor="#3A7BD5"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCardNumber"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="0000  0000  0000  0000"
                            android:inputType="number" android:maxLength="19"
                            android:textSize="16sp" android:letterSpacing="0.1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/payment_card_holder"
                        android:textColor="#888888" android:textSize="12sp"
                        android:textAlignment="viewStart" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:layout_marginBottom="12dp"
                        app:boxStrokeColor="#3A7BD5"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCardHolder"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="@string/payment_card_holder_hint"
                            android:inputType="textPersonName" android:textAllCaps="true"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/payment_expiry"
                                android:textColor="#888888" android:textSize="12sp"
                                android:textAlignment="viewStart" />
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                app:boxStrokeColor="#3A7BD5"
                                app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etExpiry"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:hint="MM/YY" android:inputType="number" android:maxLength="5"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/payment_cvv"
                                android:textColor="#888888" android:textSize="12sp"
                                android:textAlignment="viewStart" />
                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                app:boxStrokeColor="#3A7BD5"
                                app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                                app:passwordToggleEnabled="true"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etCvv"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:hint="•••" android:inputType="numberPassword" android:maxLength="4"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pay button -->
            <Button
                android:id="@+id/btnPay"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/payment_pay_btn"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#3A7BD5"
                android:textColor="@android:color/white"
                app:cornerRadius="14dp" />

        </LinearLayout>

        <!-- ===== SUCCESS SCREEN (shown after payment) ===== -->
        <LinearLayout
            android:id="@+id/layoutPaySuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="24dp">

            <!-- Green success header -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                app:cardCornerRadius="16dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="28dp"
                    android:background="#2E7D32" android:gravity="center">
                    <TextView android:layout_width="80dp" android:layout_height="80dp"
                        android:gravity="center" android:text="✓"
                        android:textSize="40sp" android:textColor="#2E7D32"
                        android:background="@drawable/bg_success_circle" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/payment_success_title"
                        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
                        android:layout_marginTop="16dp" android:gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/payment_success_subtitle"
                        android:textColor="#A5D6A7" android:textSize="14sp"
                        android:layout_marginTop="6dp" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Booking reference -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/payment_success_ref_label"
                        android:textColor="#AAAAAA" android:textSize="11sp" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvBookingRef"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#3A7BD5" android:textSize="22sp" android:textStyle="bold"
                        android:letterSpacing="0.15" android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Booking summary -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF">

                    <!-- Doctor row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingTop="6dp" android:paddingBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/payment_success_doctor_label"
                            android:textColor="#888888" android:textSize="13sp"
                            android:textAlignment="viewStart" />
                        <TextView android:id="@+id/tvSuccessDoctor"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                            android:textAlignment="viewEnd" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" />

                    <!-- Date row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingTop="6dp" android:paddingBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/payment_success_date_label"
                            android:textColor="#888888" android:textSize="13sp"
                            android:textAlignment="viewStart" />
                        <TextView android:id="@+id/tvSuccessDate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                            android:textAlignment="viewEnd" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" />

                    <!-- Hotel row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingTop="6dp" android:paddingBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/payment_success_hotel_label"
                            android:textColor="#888888" android:textSize="13sp"
                            android:textAlignment="viewStart" />
                        <TextView android:id="@+id/tvSuccessHotel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#1A1A1A" android:textSize="13sp" android:textStyle="bold"
                            android:textAlignment="viewEnd" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" />

                    <!-- Amount row -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingTop="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/payment_success_amount_label"
                            android:textColor="#888888" android:textSize="13sp"
                            android:textAlignment="viewStart" />
                        <TextView android:id="@+id/tvSuccessAmount"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="#2E7D32" android:textSize="18sp" android:textStyle="bold"
                            android:textAlignment="viewEnd" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Note -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/payment_success_note"
                android:textColor="#888888" android:textSize="13sp"
                android:gravity="center" android:lineSpacingExtra="4dp"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="32dp" android:layout_marginEnd="32dp" />

            <!-- Return to Home button -->
            <Button
                android:id="@+id/btnGoHome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/payment_home_btn"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#3A7BD5"
                android:textColor="@android:color/white"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
