<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp" app:cardElevation="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp" android:background="#3A7BD5">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔒  Güvenli Ödeme" android:textColor="#B3D4FF" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="256-bit SSL ile korunmaktadır" android:textColor="#FFFFFF"
                    android:textSize="15sp" android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Amount card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="18dp" android:background="#FFFFFF">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ÖDENECEK TUTAR" android:textColor="#AAAAAA"
                        android:textSize="11sp" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvPaymentAmount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#1A1A1A" android:textSize="28sp" android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💳" android:textSize="36sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card form -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="KART BİLGİLERİ" android:textColor="#AAAAAA"
                    android:textSize="11sp" android:letterSpacing="0.1" android:layout_marginBottom="12dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Kart Numarası" android:textColor="#888888" android:textSize="12sp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:layout_marginBottom="12dp"
                    app:boxStrokeColor="#3A7BD5" app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardNumber"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="0000  0000  0000  0000"
                        android:inputType="number" android:maxLength="19"
                        android:textSize="16sp" android:letterSpacing="0.1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Kart Sahibinin Adı" android:textColor="#888888" android:textSize="12sp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:layout_marginBottom="12dp"
                    app:boxStrokeColor="#3A7BD5" app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCardHolder"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="AD SOYAD"
                        android:inputType="textPersonName" android:textAllCaps="true"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Son Kullanma" android:textColor="#888888" android:textSize="12sp" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:boxStrokeColor="#3A7BD5" app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etExpiry"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:hint="MM/YY" android:inputType="number" android:maxLength="5"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CVV" android:textColor="#888888" android:textSize="12sp" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:boxStrokeColor="#3A7BD5" app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp" app:passwordToggleEnabled="true"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCvv"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:hint="•••" android:inputType="numberPassword" android:maxLength="3"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pay button -->
        <Button
            android:id="@+id/btnPay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:text="Ödemeyi Tamamla"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#3A7BD5"
            android:textColor="@android:color/white"
            app:cornerRadius="14dp" />

        <!-- Success layout -->
        <LinearLayout
            android:id="@+id/layoutPaySuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:text="✓"
                android:textSize="34sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_date_chip_selected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ödeme Alındı!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rezervasyonunuz onaylanmıştır.\nİyi seyahatler dileriz 🌟"
                android:textSize="15sp"
                android:textColor="#666666"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
