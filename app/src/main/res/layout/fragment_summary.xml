<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp" android:background="#3A7BD5">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📋  Rezervasyon Özeti" android:textColor="#B3D4FF" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tüm Detaylar" android:textColor="#FFFFFF"
                    android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Appointment section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🏥  İŞLEM VE RANDEVU"
                    android:textColor="#3A7BD5" android:textSize="12sp" android:textStyle="bold"
                    android:letterSpacing="0.06" android:layout_marginBottom="10dp" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowDoctor" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowCategory" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowDate" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowTime" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hotel section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="10dp"
            app:cardCornerRadius="14dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🏨  KONAKLAMA"
                    android:textColor="#3A7BD5" android:textSize="12sp" android:textStyle="bold"
                    android:letterSpacing="0.06" android:layout_marginBottom="10dp" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowHotel" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowCheckin" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowCheckout" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowStay" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Transfer section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="10dp"
            app:cardCornerRadius="14dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🚗  TRANSFER"
                    android:textColor="#3A7BD5" android:textSize="12sp" android:textStyle="bold"
                    android:letterSpacing="0.06" android:layout_marginBottom="10dp" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowDriver" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowVehicle" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowPlate" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowLanding" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowPickup" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Price section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="10dp"
            app:cardCornerRadius="14dp" app:cardElevation="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp" android:background="#EEF4FF">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💳  ÖDEME ÖZETİ"
                    android:textColor="#3A7BD5" android:textSize="12sp" android:textStyle="bold"
                    android:letterSpacing="0.06" android:layout_marginBottom="10dp" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowHotelCost" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowTransferCost" />
                <include layout="@layout/item_summary_row" android:id="@+id/rowDeposit" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#B3D4FF" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="TOPLAM" android:textColor="#1A1A1A"
                        android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvTotalAmount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#3A7BD5"
                        android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Email button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendEmail"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:text="📧   Onay Maili Gönder"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3A7BD5"
            app:strokeColor="#3A7BD5"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp" />

        <!-- Payment button -->
        <Button
            android:id="@+id/btnGoToPayment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:text="💳   Ödeme Yap"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#3A7BD5"
            android:textColor="@android:color/white"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
