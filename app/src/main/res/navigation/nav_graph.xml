<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/languageFragment">
    <fragment
        android:id="@+id/languageFragment"
        android:name="LanguageFragment"
        android:label="LanguageFragment" >
        <action
            android:id="@+id/action_languageFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_newUserLoginFragment"
            app:destination="@id/newUserLoginFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/newUserLoginFragment"
        android:name="com.example.healifyapp.NewUserLoginFragment"
        android:label="NewUserLoginFragment" >
        <action
            android:id="@+id/action_newUserLoginFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.healifyapp.DetailFragment"
        android:label="Detail">
        <argument
            android:name="doctorName"
            app:argType="string" />

        <action
            android:id="@+id/action_detailFragment_to_bookingFragment"
            app:destination="@id/bookingFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.healifyapp.BookingFragment"
        android:label="BookingFragment" >

        <argument
            android:name="selectedDoctor"
            app:argType="com.example.healifyapp.DoctorProfileBooking" />
        <action
            android:id="@+id/action_bookingFragment_to_calendarFragment"
            app:destination="@id/calendarFragment" />


    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.healifyapp.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>
    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.healifyapp.CalendarFragment"
        android:label="fragment_calendar"
        tools:layout="@layout/fragment_calendar">

        <argument
            android:name="selectedDoctor"
            app:argType="com.example.healifyapp.DoctorProfileBooking" />

        <action
            android:id="@+id/action_calendarFragment_to_bookingFragment"
            app:destination="@id/bookingFragment" />
        <action
            android:id="@+id/action_calendarFragment_to_flightFragment"
            app:destination="@id/flightFragment" />
    </fragment>

    <fragment
        android:id="@+id/flightFragment"
        android:name="com.example.healifyapp.FlightFragment"
        android:label="FlightFragment"
        tools:layout="@layout/fragment_flight">
        <argument android:name="category"          app:argType="string" />
        <argument android:name="appointmentMillis" app:argType="long" />
        <argument android:name="appointmentTime"   app:argType="string" />
        <argument android:name="doctorName"        app:argType="string" />
        <action
            android:id="@+id/action_flightFragment_to_transferFragment"
            app:destination="@id/transferFragment" />
    </fragment>

    <fragment
        android:id="@+id/transferFragment"
        android:name="com.example.healifyapp.TransferFragment"
        android:label="TransferFragment"
        tools:layout="@layout/fragment_transfer">
        <argument android:name="arrivalMillis" app:argType="long" />
        <argument android:name="doctorName"    app:argType="string" />
        <argument android:name="category"      app:argType="string" />
        <action
            android:id="@+id/action_transferFragment_to_hotelFragment"
            app:destination="@id/hotelFragment" />
    </fragment>

    <fragment
        android:id="@+id/hotelFragment"
        android:name="com.example.healifyapp.HotelFragment"
        android:label="HotelFragment"
        tools:layout="@layout/fragment_hotel">
        <action
            android:id="@+id/action_hotelFragment_to_summaryFragment"
            app:destination="@id/summaryFragment" />
    </fragment>

    <fragment
        android:id="@+id/summaryFragment"
        android:name="com.example.healifyapp.SummaryFragment"
        android:label="SummaryFragment"
        tools:layout="@layout/fragment_summary">
        <action
            android:id="@+id/action_summaryFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.example.healifyapp.PaymentFragment"
        android:label="PaymentFragment"
        tools:layout="@layout/fragment_payment" />
</navigation>